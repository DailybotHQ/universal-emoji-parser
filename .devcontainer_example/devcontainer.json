{
  "name": "Universal Emoji Parser",
  "dockerComposeFile": "../docker/local/docker-compose.yaml",
  "service": "uemojiparservscode",
  "workspaceFolder": "/app",
  "runServices": ["uemojiparservscode"],
  "remoteUser": "node",
  "customizations": {
    "settings": {
      "terminal.integrated.shell.linux": "/bin/bash"
    },
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "VisualStudioExptTeam.vscodeintellicode",
        "vscode-icons-team.vscode-icons",
        "biomejs.biome",
        "vitest.explorer",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
