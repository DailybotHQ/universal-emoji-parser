{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run eslint:check)",
      "Bash(npm run eslint:fix)",
      "Bash(npm run prettier:check)",
      "Bash(npm run prettier:fix)",
      "Bash(npm run build)",
      "Bash(npm run build:dev)",
      "Bash(npm run build:tsc)",
      "Bash(npm run ncu:check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Bash(npm run release)", "Bash(npm publish:*)"]
  }
}
