{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Mocha Tests",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/node_modules/mocha/bin/mocha.js",
      "args": ["${workspaceFolder}/test/**/*.ts", "--timeout", "2000", "--colors"],
      "internalConsoleOptions": "openOnSessionStart"
    }
  ]
}
